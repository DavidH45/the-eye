# --- The Eye configuration ---

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=your-bot-token-here

# The Discord user ID (snowflake) you want to track.
# Enable Developer Mode in Discord (Settings -> Advanced), then right-click the user -> Copy User ID.
# The bot MUST share at least one server with this user.
TARGET_USER_ID=000000000000000000

# Web dashboard port
PORT=3000

# SQLite database file (created automatically)
DB_PATH=./data/theeye.db

# How often (seconds) the bot writes a heartbeat so downtime is not counted as active time
HEARTBEAT_SECONDS=30
